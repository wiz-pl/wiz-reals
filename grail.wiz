import Grail
-- `grail build`: check the library (every module under src/; the kernel checks every
-- proof) and compile the √2 example, `.grail/bin/sqrt2`.
-- `grail test`: the tests under tests/.
def package : Package := Package.new "wiz-reals"
  |> Package.lib "reals" "src"
  |> Package.exe "sqrt2" "app/sqrt2.wiz"
  |> Package.tests "tests" "tests"
