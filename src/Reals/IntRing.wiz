import Reals.Int
-- Equations of commutative rings at `Int`, by reflection through pairs of naturals.
--
-- `IE.toPair e` is a pair of `NE`s whose difference is `e` (each atom `aᵢ` becomes the
-- difference of the atoms `2i` and `2i+1`, its positive and negative parts). Two
-- expressions are equal when `p₁ + q₂` and `q₁ + p₂` have the same normal form.
-- `int_pair_ring! lhs = rhs` builds the expressions from the syntax, as `nat_ring!` does.

inductive IE where
  | atom (i : Nat)
  | lit (n : Nat)
  | add (a b : IE)
  | mul (a b : IE)
  | neg (a : IE)
  | sub (a b : IE)

def IE.get : List Int → Nat → Int
  | .nil, _ => 0
  | .cons x _, .zero => x
  | .cons _ xs, .succ i => IE.get xs i

def IE.eval (ρ : List Int) : IE → Int
  | .atom i => IE.get ρ i
  | .lit n => Int.ofNat n
  | .add a b => IE.eval ρ a + IE.eval ρ b
  | .mul a b => IE.eval ρ a * IE.eval ρ b
  | .neg a => -(IE.eval ρ a)
  | .sub a b => IE.eval ρ a - IE.eval ρ b

def IE.env : List Int → List Nat
  | .nil => .nil
  | .cons a ρ => .cons (Int.pos a) (.cons (Int.negp a) (IE.env ρ))

def IE.toPair : IE → NE × NE
  | .atom i => (.atom (i + i), .atom (Nat.succ (i + i)))
  | .lit n => (.lit n, .lit 0)
  | .add a b => (.add (IE.toPair a).1 (IE.toPair b).1, .add (IE.toPair a).2 (IE.toPair b).2)
  | .mul a b =>
    (.add (.mul (IE.toPair a).1 (IE.toPair b).1) (.mul (IE.toPair a).2 (IE.toPair b).2),
     .add (.mul (IE.toPair a).1 (IE.toPair b).2) (.mul (IE.toPair a).2 (IE.toPair b).1))
  | .neg a => ((IE.toPair a).2, (IE.toPair a).1)
  | .sub a b => (.add (IE.toPair a).1 (IE.toPair b).2, .add (IE.toPair a).2 (IE.toPair b).1)

def IE.env_get : (ρ : List Int) → (i : Nat) →
    (NE.get (IE.env ρ) (i + i) = Int.pos (IE.get ρ i)) ∧ (NE.get (IE.env ρ) (Nat.succ (i + i)) = Int.negp (IE.get ρ i))
  | .nil, _ => (rfl, rfl)
  | .cons _ _, .zero => (rfl, rfl)
  | .cons a ρ, .succ i =>
    -- succ i + succ i = succ (succ (i + i))
    let e : Nat.succ i + Nat.succ i = Nat.succ (Nat.succ (i + i)) := congrArg Nat.succ (Nat.add_succ i i);
    let ih := IE.env_get ρ i;
    (Eq.trans (congrArg (NE.get (IE.env (.cons a ρ))) e) ih.1,
     Eq.trans (congrArg (fun j => NE.get (IE.env (.cons a ρ)) (Nat.succ j)) e) ih.2)

def IE.sound (ρ : List Int) : (e : IE) →
    IE.eval ρ e = Int.ofPair (NE.eval (IE.env ρ) (IE.toPair e).1) (NE.eval (IE.env ρ) (IE.toPair e).2)
  | .atom i =>
    let h := IE.env_get ρ i;
    Eq.trans (Int.pair (IE.get ρ i)) (congrArg2 Int.ofPair (Eq.symm h.1) (Eq.symm h.2))
  | .lit n => Int.ofNat_pair n
  | .add a b =>
    Eq.trans (congrArg2 (fun x y => x + y) (IE.sound ρ a) (IE.sound ρ b)) (Int.ofPair_add _ _ _ _)
  | .mul a b =>
    Eq.trans (congrArg2 (fun x y => x * y) (IE.sound ρ a) (IE.sound ρ b)) (Int.ofPair_mul _ _ _ _)
  | .neg a => Eq.trans (congrArg (fun x => -x) (IE.sound ρ a)) (Int.ofPair_negate _ _)
  | .sub a b =>
    Eq.trans (congrArg2 (fun x y => x - y) (IE.sound ρ a) (IE.sound ρ b)) (Int.ofPair_sub _ _ _ _)

def IE.provePairs (ρ : List Int) (a b : IE)
    (h : Poly.beq (NE.norm (.add (IE.toPair a).1 (IE.toPair b).2)) (NE.norm (.add (IE.toPair b).1 (IE.toPair a).2)) = .true) :
    IE.eval ρ a = IE.eval ρ b :=
  Eq.trans (IE.sound ρ a)
    (Eq.trans (Int.ofPair_eq _ _ _ _ (NE.prove (IE.env ρ) (.add (IE.toPair a).1 (IE.toPair b).2) (.add (IE.toPair b).1 (IE.toPair a).2) h))
      (Eq.symm (IE.sound ρ b)))

-- (`int_pair_ring!` is the bootstrap: it proves the lemmas of Reals.ZRing, whose
-- `int_ring!` normalises with integer coefficients and is much faster)
def IntPairRing.expand : Macro := fun stx => Reify.expandWith "IE" "provePairs" stx
syntax:lead (name := intPairRing) "int_pair_ring!" term : term
attribute [macro term.intPairRing] IntPairRing.expand
