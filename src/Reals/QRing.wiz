import Reals.Rat
-- Equations of rationals that hold in every commutative ring, by reflection:
-- `q_ring! lhs ≈ rhs`. A rational expression has a numerator and a denominator that
-- are integer expressions in the numerators and denominators of its atoms, and
-- `lhs ≈ rhs` is the integer equation `num lhs · den rhs = num rhs · den lhs`, which
-- `IE.prove` decides.

inductive QE where
  | atom (i : Nat)
  | lit (n : Nat)
  | add (a b : QE)
  | mul (a b : QE)
  | neg (a : QE)
  | sub (a b : QE)

def QE.get : List Q → Nat → Q
  | .nil, _ => 0
  | .cons x _, .zero => x
  | .cons _ xs, .succ i => QE.get xs i

def QE.eval (ρ : List Q) : QE → Q
  | .atom i => QE.get ρ i
  | .lit n => Q.ofInt (Int.ofNat n)
  | .add a b => QE.eval ρ a + QE.eval ρ b
  | .mul a b => QE.eval ρ a * QE.eval ρ b
  | .neg a => -(QE.eval ρ a)
  | .sub a b => QE.eval ρ a - QE.eval ρ b

-- atom `i` is `num / den`, with `num` at `2i` and `den` at `2i + 1` in the environment.
-- An atom past the end of `ρ` would be `0 / 1` for `QE.get` but `0 / 0` here, so
-- `QE.prove` checks that there is none (`QE.wf`).
def QE.env : List Q → List Int
  | .nil => .nil
  | .cons p ρ => .cons p.num (.cons p.den (QE.env ρ))

def QE.wf (n : Nat) : QE → Bool
  | .atom i => Nat.lt i n
  | .lit _ => .true
  | .add a b => Bool.and (QE.wf n a) (QE.wf n b)
  | .mul a b => Bool.and (QE.wf n a) (QE.wf n b)
  | .neg a => QE.wf n a
  | .sub a b => Bool.and (QE.wf n a) (QE.wf n b)

def QE.toIE.add (x y : IE × IE) : IE × IE := (.add (.mul x.1 y.2) (.mul y.1 x.2), .mul x.2 y.2)
def QE.toIE.mul (x y : IE × IE) : IE × IE := (.mul x.1 y.1, .mul x.2 y.2)
def QE.toIE.neg (x : IE × IE) : IE × IE := (.neg x.1, x.2)
def QE.toIE.sub (x y : IE × IE) : IE × IE := (.add (.mul x.1 y.2) (.mul (.neg y.1) x.2), .mul x.2 y.2)
-- the numerator and the denominator (each recursive call once)
def QE.toIE : QE → IE × IE
  | .atom i => (.atom (i + i), .atom (Nat.succ (i + i)))
  | .lit n => (.lit n, .lit 1)
  | .add a b => QE.toIE.add (QE.toIE a) (QE.toIE b)
  | .mul a b => QE.toIE.mul (QE.toIE a) (QE.toIE b)
  | .neg a => QE.toIE.neg (QE.toIE a)
  | .sub a b => QE.toIE.sub (QE.toIE a) (QE.toIE b)

def QE.env_get : (ρ : List Q) → (i : Nat) → Nat.lt i (List.length ρ) = .true →
    (IE.get (QE.env ρ) (i + i) = (QE.get ρ i).num) ∧
    (IE.get (QE.env ρ) (Nat.succ (i + i)) = (QE.get ρ i).den)
  | .nil, i, h => absurd (Bool.trueNeFalse (Eq.trans (Eq.symm h) (Nat.lt_zero i)))
  | .cons p _, .zero, _ => (rfl, rfl)
  | .cons p ρ, .succ i, h =>
    let e : Nat.succ i + Nat.succ i = Nat.succ (Nat.succ (i + i)) := congrArg Nat.succ (Nat.add_succ i i);
    let ih := QE.env_get ρ i h;
    (Eq.trans (congrArg (IE.get (QE.env (.cons p ρ))) e) ih.1,
     Eq.trans (congrArg (fun j => IE.get (QE.env (.cons p ρ)) (Nat.succ j)) e) ih.2)

def QE.sound (ρ : List Q) : (e : QE) → QE.wf (List.length ρ) e = .true →
    ((QE.eval ρ e).num = IE.eval (QE.env ρ) (QE.toIE e).1) ∧
    ((QE.eval ρ e).den = IE.eval (QE.env ρ) (QE.toIE e).2)
  | .atom i, hw => let h := QE.env_get ρ i hw; (Eq.symm h.1, Eq.symm h.2)
  | .lit n, _ => (rfl, rfl)
  | .add a b, hw =>
    let ha := QE.sound ρ a (Bool.and_left _ _ hw);
    let hb := QE.sound ρ b (Bool.and_right _ _ hw);
    (congrArg2 (fun x y => x + y) (congrArg2 (fun x y => x * y) ha.1 hb.2) (congrArg2 (fun x y => x * y) hb.1 ha.2),
     congrArg2 (fun x y => x * y) ha.2 hb.2)
  | .mul a b, hw =>
    let ha := QE.sound ρ a (Bool.and_left _ _ hw);
    let hb := QE.sound ρ b (Bool.and_right _ _ hw);
    (congrArg2 (fun x y => x * y) ha.1 hb.1, congrArg2 (fun x y => x * y) ha.2 hb.2)
  | .neg a, hw => let ha := QE.sound ρ a hw; (congrArg (fun x => -x) ha.1, ha.2)
  | .sub a b, hw =>
    let ha := QE.sound ρ a (Bool.and_left _ _ hw);
    let hb := QE.sound ρ b (Bool.and_right _ _ hw);
    (congrArg2 (fun x y => x + y) (congrArg2 (fun x y => x * y) ha.1 hb.2) (congrArg2 (fun x y => -x * y) hb.1 ha.2),
     congrArg2 (fun x y => x * y) ha.2 hb.2)

-- `h` checks both the atoms and the normal forms
def QE.prove (ρ : List Q) (a b : QE)
    (h : Bool.and (Bool.and (QE.wf (List.length ρ) a) (QE.wf (List.length ρ) b))
           (ZPoly.beq (IE.norm (.mul (QE.toIE a).1 (QE.toIE b).2)) (IE.norm (.mul (QE.toIE b).1 (QE.toIE a).2))) = .true) :
    QE.eval ρ a ≈ QE.eval ρ b :=
  let hw := Bool.and_left _ _ h;
  let ha := QE.sound ρ a (Bool.and_left _ _ hw);
  let hb := QE.sound ρ b (Bool.and_right _ _ hw);
  Eq.trans (congrArg2 (fun x y => x * y) ha.1 hb.2)
    (Eq.trans (IE.prove (QE.env ρ) (.mul (QE.toIE a).1 (QE.toIE b).2) (.mul (QE.toIE b).1 (QE.toIE a).2) (Bool.and_right _ _ h))
      (Eq.symm (congrArg2 (fun x y => x * y) hb.1 ha.2)))

def QE.proveAt (x y : Q) (ρ : List Q) (a b : QE) (hx : QE.eval ρ a = x) (hy : QE.eval ρ b = y)
    (h : Bool.and (Bool.and (QE.wf (List.length ρ) a) (QE.wf (List.length ρ) b))
           (ZPoly.beq (IE.norm (.mul (QE.toIE a).1 (QE.toIE b).2)) (IE.norm (.mul (QE.toIE b).1 (QE.toIE a).2))) = .true) :
    x ≈ y :=
  @Eq.mp' Q (QE.eval ρ b) y (fun z => x ≈ z) hy (@Eq.mp' Q (QE.eval ρ a) x (fun z => z ≈ QE.eval ρ b) hx (QE.prove ρ a b h))

def QRing.expand : Macro := fun stx => Reify.expand "QE" stx
syntax:lead (name := qRing) "q_ring!" term : term
attribute [macro term.qRing] QRing.expand
