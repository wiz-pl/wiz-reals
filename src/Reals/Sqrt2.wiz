import Reals.Complete
import Reals.Isqrt
-- √2: digits with a bound on the error of their square, and √2 as a real number.

-- ## Facts about naturals

def Nat.lt_of_mul_self_lt (p q : Nat) (h : Nat.Lt (p * p) (q * q)) : Nat.Lt p q :=
  Or.elim (Bool.cases (Nat.le q p))
    (fun (hle : Nat.le q p = .true) =>
      absurd (Nat.lt_irrefl (p * p) (Nat.lt_of_lt_of_le (p * p) (q * q) (p * p) h (Nat.mul_le_mul q p q p hle hle))))
    (fun (hf : Nat.le q p = .false) => Nat.not_le q p hf)

-- ## The approximation `d/P` with `d = isqrt (2P²)`

def Sqrt2.d (P : Nat) : Nat := Nat.isqrt (2 * (P * P))
def Sqrt2.lo (P : Nat) : Nat.Le (Sqrt2.d P * Sqrt2.d P) (2 * (P * P)) := (Nat.isqrt_spec (2 * (P * P))).1
def Sqrt2.hi (P : Nat) : Nat.Lt (2 * (P * P)) (Nat.succ (Sqrt2.d P) * Nat.succ (Sqrt2.d P)) := (Nat.isqrt_spec (2 * (P * P))).2
-- `2P² ≤ d² + 2d`
def Sqrt2.gap (P : Nat) : Nat.Le (2 * (P * P)) (Sqrt2.d P * Sqrt2.d P + 2 * Sqrt2.d P) :=
  Eq.mp' (fun (z : Nat) => Nat.Le (2 * (P * P)) z)
    (nat_ring! Sqrt2.d P + Sqrt2.d P * Nat.succ (Sqrt2.d P) = Sqrt2.d P * Sqrt2.d P + 2 * Sqrt2.d P) (Sqrt2.hi P)
-- `d < 2P` (for `P ≥ 1`)
def Sqrt2.d_lt (p : Nat) : Nat.Lt (Sqrt2.d (Nat.succ p)) (2 * Nat.succ p) :=
  let P := Nat.succ p;
  Nat.lt_of_mul_self_lt (Sqrt2.d P) (2 * P)
    (Nat.lt_of_le_of_lt (Sqrt2.d P * Sqrt2.d P) (2 * (P * P)) (2 * P * (2 * P)) (Sqrt2.lo P)
      (Eq.mp' (fun (z : Nat) => Nat.Lt (2 * (P * P)) z) (nat_ring! Nat.succ (2 * (Nat.succ p * Nat.succ p)) + (2 * (p * Nat.succ p) + 2 * p + 1) = 2 * Nat.succ p * (2 * Nat.succ p))
        (Nat.le_add_right (Nat.succ (2 * (P * P))) (2 * (p * P) + 2 * p + 1))))

def Sqrt2.approx (p : Nat) : Q :=
  Q.mk (Int.ofNat (Sqrt2.d (Nat.succ p))) (Int.ofNat (Nat.succ p)) (Int.ofNat_succ_pos p)
-- the error bound `4/P`
def Sqrt2.err (p : Nat) : Q := Q.mk 4 (Int.ofNat (Nat.succ p)) (Int.ofNat_succ_pos p)

-- **The digits square to 2 within the error**: `|(d/P)² - 2| ≤ 4/P`, `P = p + 1`.
def Sqrt2.approx_sq (p : Nat) : Q.abs (Sqrt2.approx p * Sqrt2.approx p - 2) ≤ Sqrt2.err p :=
  let P := Nat.succ p;
  let d := Sqrt2.d P;
  let D := Int.ofNat d;
  let PP := Int.ofNat P;
  let hA : Int.Le (D * D) (2 * (PP * PP)) := Int.ofNat_le (d * d) (2 * (P * P)) (Sqrt2.lo P);
  let hB : Int.Le (2 * (PP * PP)) (D * D + 2 * D) := Int.ofNat_le (2 * (P * P)) (d * d + 2 * d) (Sqrt2.gap P);
  let hC : Int.Lt D (2 * PP) :=
    @Int.Le.congr (Int.ofNat (Nat.succ d)) (Int.ofNat (2 * P)) (D + 1) (2 * PP)
      (Int.ofNat_succ d) (refl (Int.ofNat (2 * P))) (Int.ofNat_le (Nat.succ d) (2 * P) (Sqrt2.d_lt p));
  let hPP : Int.NonNeg PP := Int.nonneg_ofNat P;
  let up : Sqrt2.approx p * Sqrt2.approx p - 2 ≤ Sqrt2.err p :=
    Int.NonNeg.congr (int_ring! 4 * (PP * PP) + (2 * (PP * PP) - D * D) * PP = 4 * (PP * PP * 1) - (D * D * 1 + -2 * (PP * PP)) * PP)
      (Int.nonneg_add _ _ (Int.nonneg_mul 4 (PP * PP) rfl (Int.nonneg_mul PP PP hPP hPP)) (Int.nonneg_mul _ PP hA hPP));
  let lo : -(Sqrt2.err p) ≤ Sqrt2.approx p * Sqrt2.approx p - 2 :=
    Int.NonNeg.congr (int_ring! (2 * (2 * PP - (D + 1)) + (D * D + 2 * D - 2 * (PP * PP)) + 2) * PP
        = (D * D * 1 + -2 * (PP * PP)) * PP - -4 * (PP * PP * 1))
      (Int.nonneg_mul _ PP
        (Int.nonneg_add _ 2 (Int.nonneg_add _ _ (Int.nonneg_mul 2 _ rfl hC) hB) rfl) hPP);
  Q.abs_le_of_bounds lo up

-- ## √2 as a real number: `xₙ = d(n+1)/(n+1)`

def Nat.mul_lt_mul_right_succ (a b c' : Nat) (h : Nat.Lt a b) : Nat.Lt (a * Nat.succ c') (b * Nat.succ c') :=
  -- a(c'+1) < (a+1)(c'+1) ≤ b(c'+1)
  Nat.lt_of_lt_of_le (a * Nat.succ c') (Nat.succ a * Nat.succ c') (b * Nat.succ c')
    (Eq.mp' (fun (z : Nat) => Nat.Lt (a * Nat.succ c') z) (nat_ring! Nat.succ (a * Nat.succ c') + c' = Nat.succ a * Nat.succ c')
      (Nat.le_add_right (Nat.succ (a * Nat.succ c')) c'))
    (Nat.mul_le_mul_right (Nat.succ c') (Nat.succ a) b h)

-- `d(M)·N < (d(N) + 1)·M`: both are `√2·M·N` rounded the right way
def Sqrt2.cross (m n : Nat) :
    Nat.Lt (Sqrt2.d (Nat.succ m) * Nat.succ n) (Nat.succ (Sqrt2.d (Nat.succ n)) * Nat.succ m) :=
  let M := Nat.succ m;
  let N := Nat.succ n;
  let a := Sqrt2.d M;
  let b := Nat.succ (Sqrt2.d N);
  Nat.lt_of_mul_self_lt (a * N) (b * M)
    (Nat.lt_of_le_of_lt (a * N * (a * N)) (2 * (M * M) * (N * N)) (b * M * (b * M))
      (Eq.mp' (fun (z : Nat) => Nat.Le z (2 * (M * M) * (N * N))) (nat_ring! a * a * (N * N) = a * N * (a * N))
        (Nat.mul_le_mul_right (N * N) (a * a) (2 * (M * M)) (Sqrt2.lo M)))
      (Eq.mp' (fun (z : Nat) => Nat.Lt z (b * M * (b * M))) (nat_ring! 2 * (N * N) * (M * M) = 2 * (M * M) * (N * N))
        (Eq.mp' (fun (z : Nat) => Nat.Lt (2 * (N * N) * (M * M)) z) (nat_ring! b * b * (M * M) = b * M * (b * M))
          (Nat.mul_lt_mul_right_succ (2 * (N * N)) (b * b) (m + m * Nat.succ m) (Sqrt2.hi N)))))

def Sqrt2.diff_le (m n : Nat) : Sqrt2.approx m - Sqrt2.approx n ≤ Q.invS n :=
  let DM := Int.ofNat (Sqrt2.d (Nat.succ m));
  let DN := Int.ofNat (Sqrt2.d (Nat.succ n));
  let MM := Int.ofNat (Nat.succ m);
  let NN := Int.ofNat (Nat.succ n);
  -- DM·NN + 1 ≤ (DN + 1)·MM
  let h : Int.Le (DM * NN + 1) ((DN + 1) * MM) :=
    @Int.Le.congr (Int.ofNat (Nat.succ (Sqrt2.d (Nat.succ m) * Nat.succ n))) (Int.ofNat (Nat.succ (Sqrt2.d (Nat.succ n)) * Nat.succ m))
      (DM * NN + 1) ((DN + 1) * MM)
      (Int.ofNat_succ (Sqrt2.d (Nat.succ m) * Nat.succ n))
      (@congrArg Int Int (fun z => z * MM) (Int.ofNat (Nat.succ (Sqrt2.d (Nat.succ n)))) (DN + 1) (Int.ofNat_succ (Sqrt2.d (Nat.succ n))))
      (Int.ofNat_le _ _ (Sqrt2.cross m n));
  Int.NonNeg.congr (int_ring! ((DN + 1) * MM - (DM * NN + 1)) * NN + NN = 1 * (MM * NN) - (DM * NN + -DN * MM) * NN)
    (Int.nonneg_add _ NN (Int.nonneg_mul _ NN h (Int.nonneg_ofNat (Nat.succ n))) (Int.nonneg_ofNat (Nat.succ n)))

def R.sqrt2 : R := R.mk Sqrt2.approx (fun m n =>
  Q.abs_le
    (Q.le_trans (Sqrt2.diff_le m n) (Q.le_congr (q_ring! 0 + Q.invS n ≈ Q.invS n) (Q.refl _) (Q.add_le_add_right (Q.invS n) (Q.invS_nonneg m))))
    (Q.le_trans (Q.le_of_eq (q_ring! -(Sqrt2.approx m - Sqrt2.approx n) ≈ Sqrt2.approx n - Sqrt2.approx m))
      (Q.le_trans (Sqrt2.diff_le n m) (Q.le_congr (q_ring! Q.invS m + 0 ≈ Q.invS m) (Q.refl _) (Q.add_le_add_left (Q.invS m) (Q.invS_nonneg n))))))

def Sqrt2.err_eq' (p : Nat) : Int.ofNat 4 * (1 * Int.ofNat (Nat.succ p)) = Int.ofNat 4 * 1 * Int.ofNat (Nat.succ p) :=
  congrArg Int.ofNat (nat_ring! 4 * (1 * Nat.succ p) = 4 * 1 * Nat.succ p)
def Sqrt2.err_eq (p : Nat) : Sqrt2.err p ≈ 4 * Q.invS p := Sqrt2.err_eq' p
-- **√2 · √2 = 2**
def R.sqrt2_sq : R.sqrt2 * R.sqrt2 ≈ 2 :=
  R.eq_of_bound (R.sqrt2 * R.sqrt2) 2 4 (fun n =>
    let j := R.mulIdx R.sqrt2 R.sqrt2 n;
    Q.le_trans (Sqrt2.approx_sq j)
      (Q.le_trans (Q.le_of_eq (Sqrt2.err_eq j))
        (Q.mul_le_mul_of_nonneg_left 4 (Q.ofNat_nonneg 4) (Q.invS_anti n j (R.mulIdx_ge R.sqrt2 R.sqrt2 n)))))
