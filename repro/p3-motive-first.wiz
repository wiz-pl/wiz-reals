-- test: check
import Nat
-- FINDINGS.md P3: with the motive before the equation (Eq.mp', lib/Nat.wiz), the
-- motive's domain is still a hole when the lambda is elaborated, and a later
-- argument forces the placeholder. The expected output is today's error.
def Eq.mpMotiveFirst {A : Type} {a b : A} (0 P : A → Prop) (e : a = b) (h : P a) : P b :=
  Eq.substProp P e h
def t (a b k : Nat) (e : a = b) (h : Nat.Le a (b + k)) : Nat.Le b (b + k) :=
  Eq.mpMotiveFirst (fun x => Nat.Le x (b + k)) e h
