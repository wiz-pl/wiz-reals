-- A concrete (constant) bisection certificate, so the root theorem is exercised,
-- not only `#check`ed.
def zeroNested : R.Nested :=
  R.Nested.mk (fun _ => (0 : R)) (fun _ => (0 : R)) (R.regSeq_const 0)
    (fun n => R.dist_self 0 (Q.invS n) (Q.invS_nonneg n))
    (fun m n h => R.dist_self 0 (Q.invS m) (Q.invS_nonneg m))

def zeroBracket : R.Bracket (fun _ => (0 : R)) :=
  R.Bracket.mk zeroNested
    (fun n => R.dist_mono (R.lim_spec (fun _ => (0 : R)) (R.regSeq_const 0) n)
      (Q.le_add_self (Q.invS n) (Q.invS n) (Q.invS_nonneg n)))
    (fun n k => Q.le_trans (Q.le_of_eq (R.zero_seq k)) (Q.invS_nonneg k))
    (fun n k => Q.le_trans (Q.neg_invS_le_zero k) (Q.le_of_eq (Q.symm (R.zero_seq k))))

#check R.ivt_approx (fun _ => (0 : R)) (R.continuous_const 0) zeroBracket
